esultsCount":"{count} visible records","allMetrics":"All measurements","viewSource":"View source","stepLabel":"STEP {number}","slideOf":"{current} / {total}","sourceScope":"Source scope","futureNote":"Future days become available on their date.","resetComplete":"Week cleared.","demoNoSave":"The example does not change your personal data.","unitsDisclaimer":"Check that units match your laboratory report.","slideCreditLabel":"INTERUNIVERSITY COLLABORATION","parts":[{"id":"corteza","title":"Renal cortex","description":"The outer layer. It contains structures where blood filtration begins."},{"id":"medula","title":"Renal medulla","description":"The inner region. Its tubules help concentrate urine and recover water and substances the body needs."},{"id":"glomerulo","title":"Glomerulus","description":"A small cluster of vessels acting as a filter. Water and waste pass through; large proteins usually stay in the blood."},{"id":"ureter","title":"Ureter","description":"The tube carrying urine from the kidney to the bladder. It does not carry blood."},{"id":"arteria","title":"Renal artery","description":"The vessel supplying blood to the kidney. High glucose and blood pressure can damage small vessels in the filtration system."}],"filterStages":[{"title":"A barrier that selects.","description":"With preserved filtration, water and small molecules pass through. Blood cells and most large proteins remain in circulation."},{"title":"Small vessels face pressure.","description":"Sustained high glucose and elevated pressure can affect filter structures. There may be no symptoms at first."},{"title":"Some proteins may pass through.","description":"When the barrier changes, urine albumin may increase. A test measures it; looking at urine cannot confirm it."},{"title":"Filtration may decrease.","description":"If damage progresses, the kidney may remove less waste. Repeated tests and clinical context assess progression; care and treatment may slow it."}],"sections":[{"id":"causas","tab":"Causes and risks","eyebrow":"01 / UNDERSTAND","title":"Why can kidney damage occur?","description":"Diabetic kidney disease is kidney damage related to type 1 or type 2 diabetes. Long-term high glucose can affect the kidney’s small blood vessels.","pointsTitle":"Factors that can increase risk","points":["More years with diabetes and sustained high glucose.","High blood pressure, cholesterol and triglycerides.","Age, family history of kidney disease and previous kidney injury.","Smoking, inactivity, excess salt and obesity."],"note":"Risk can be reduced: managing glucose and blood pressure, following treatment and attending checkups helps protect the kidneys.","sources":["niddk-dkd","mayo"]},{"id":"epidemiologia","tab":"Who is affected?","eyebrow":"02 / GLOBAL PERSPECTIVE","title":"Prevention starts with context.","description":"Kidney disease is an important diabetes complication worldwide. Risk varies with diabetes duration, age, glucose control, blood pressure, weight and blood lipids.","pointsTitle":"A figure needs context","points":["Comparing countries requires knowing the population, year and disease definition.","Draft figures are displayed pending verification.","A population statistic does not predict an individual’s progression."],"note":"Not everyone with diabetes develops kidney damage. Statistics help study the issue; checkups guide personal care.","sources":["niddk-dkd"]},{"id":"prevencion","tab":"Daily care","eyebrow":"03 / CARE","title":"Daily care can make a difference.","description":"Early detection and diabetes management can prevent or delay complications. Damage can develop slowly without obvious signs.","pointsTitle":"Care to agree on with your team","points":["Glucose and pressure: know your targets and monitor as advised.","Medicines: follow prescribed treatment and ask before making changes.","Avoid tobacco and vaping; seek support to quit.","Adapted activity: one possible goal is 30 minutes on 5 days. Include strength work if advised.","Food and fluids: review salt and adapt amounts to your results.","Checkups: ask about yearly tests for type 2 diabetes and after 5 years of type 1 diabetes, or sooner if advised."],"note":"This is not an absolute guarantee of prevention. Testing frequency, exercise and targets must be adapted to each person.","sources":["niddk-dkd","cdc-activity","niddk-diet"]},{"id":"manifestaciones","tab":"Signs and tests","eyebrow":"04 / DETECT","title":"Tests are part of the answer.","description":"Early stages can have few or no symptoms. Blood and urine tests help assess how the kidneys work.","pointsTitle":"Two complementary tests","points":["Blood: creatinine helps the laboratory estimate glomerular filtration rate (eGFR).","Urine: the albumin/creatinine ratio helps assess protein loss.","The team interprets repeated results alongside clinical history.","Thirst and frequent urination can accompany diabetes; they do not confirm kidney damage."],"note":"Swelling, changes in urine or tiredness need assessment. General diabetes symptoms should not be confused with confirmation of kidney disease.","sources":["niddk-tests","cdc-signs","mayo"]}],"symptomCategories":[{"title":"General diabetes symptoms","subtitle":"These are not proof of kidney damage.","items":["Thirst and frequent urination","Extreme hunger","Tiredness and dizziness","Wounds that heal slowly"]},{"title":"Signs needing kidney assessment","subtitle":"They can also have other causes.","items":["Swelling in feet, legs, hands or face","Foamy urine or changes in frequency, color or smell","Nausea, poor appetite or persistent tiredness"]},{"title":"Other diabetes-related effects","subtitle":"Complications assessed separately.","items":["High pressure and cardiovascular risk","Vision changes","Loss of sensation in the feet"]},{"title":"Laboratory findings","subtitle":"Detected in blood and urine.","items":["Elevated urine albumin or proteins","Decreased estimated filtration","Progressive changes in repeated tests"]}],"symptomChecks":[{"id":"breathing","text":"Severe difficulty breathing right now","urgent":true},{"id":"confusion","text":"Sudden confusion or difficulty staying alert","urgent":true},{"id":"swelling","text":"New or persistent swelling","urgent":false},{"id":"urine","text":"Persistent urine changes","urgent":false},{"id":"nausea","text":"Persistent nausea, low appetite or tiredness","urgent":false},{"id":"diabetes","text":"Thirst, frequent urination or slow-healing wounds","urgent":false}],"habits":[{"id":"activity","title":"Adapted activity","detail":"30 min, if advised","target":5},{"id":"tobacco","title":"No tobacco or vaping","detail":"Seek support when needed","target":7},{"id":"glucose","title":"Glucose as planned","detail":"Only the advised frequency","target":7},{"id":"medicine","title":"Prescribed medicines","detail":"According to prescription","target":7},{"id":"salt","title":"Mindful of salt","detail":"Check labels and preparations","target":7},{"id":"fluids","title":"Fluids as planned","detail":"The amount advised by my team","target":7}],"creditsBlocks":[{"number":"01","title":"Collaborative design","text":"Laura’s mockup is the starting point: illustration on the left, information on the right, measurements and recommendations. This version keeps that logic and expands interaction."},{"number":"02","title":"Building knowledge","text":"Zoom meetings and work across universities bring together causes, epidemiology, prevention and detection. The team will add meeting evidence and participant names."},{"number":"03","title":"Accessible language","text":"Spanish and English versions make sharing easier. Both translations require academic and terminology review by the participating teams."},{"number":"04","title":"Next steps","text":"Confirm epidemiological sources, validate individual ranges, approve recipes and complete credits. Publication and the domain will be decided after this review."}],"universities":["Universidad Católica de Colombia","Tecnológico de 